GANTRY_WEB_PORT=8788
GANTRY_WEB_HOST=0.0.0.0
GANTRY_WEB_DATA_DIR=./data
GANTRY_WEB_PUBLIC_URL=https://gantry.example.com

# Required only for the first configuration in the browser. Generate with:
# openssl rand -hex 24
GANTRY_WEB_SETUP_TOKEN=replace-with-at-least-24-random-characters

# Optional. Defaults are suitable for a personal installation.
GANTRY_WEB_SESSION_HOURS=12
GANTRY_WEB_SNAPSHOT_TTL_SECONDS=45
GANTRY_WEB_MAX_BODY_BYTES=1048576
