<Window x:Class="Gantry.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gantry" Width="660" Height="660"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="Transparent"
        Foreground="#FFF5F5F7" FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <!-- Soft, macOS-like buttons instead of the default Windows button chrome. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rounded, translucent panel body; the acrylic/mica backdrop (set via DWM) shows through.
         PanelBody.Background alpha is set from the Panel-transparency setting (backdrop only). -->
    <Border x:Name="PanelBody" CornerRadius="12" Background="#B3242426" SnapsToDevicePixels="True">
        <Grid>
            <DockPanel Margin="2">
                <Grid DockPanel.Dock="Top" Margin="16,14,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="GANTRY" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusLine" FontSize="11" Foreground="#FF9A9A9E" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CompactButton" MinWidth="64" Height="30" Margin="4,0" Padding="8,0" Visibility="Collapsed"/>
                        <Button x:Name="ScanButton" Content="⟳" Width="32" Height="30" Margin="4,0" ToolTip="Scan"/>
                        <Button x:Name="AddButton" Content="+" Width="32" Height="30" Margin="4,0" FontSize="17" ToolTip="Add printer"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                           FontSize="10" Foreground="#8A8A8E" Margin="0,4,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="9,2,9,10">
                    <WrapPanel x:Name="CardsPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
            <!-- In-window card menu overlay (avoids Popup z-order issues under a topmost window). -->
            <Grid x:Name="MenuLayer" Visibility="Collapsed">
                <Border x:Name="MenuBackdrop" Background="#01000000"/>
            </Grid>
        </Grid>
    </Border>
</Window>
