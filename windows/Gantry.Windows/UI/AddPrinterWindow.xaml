<Window x:Class="Gantry.UI.AddPrinterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gantry" Width="430" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="False" Background="Transparent"
        Foreground="#FFF5F5F7" FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource GantryHoverBrush}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Background" Value="{DynamicResource GantryPressedBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="CaretBrush" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="#FF2C2C2E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="7"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#FF0A84FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="16,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource GantryHoverBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#FF0A84FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="check" Text="✓" FontSize="13" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF0A84FF"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF0A84FF"/>
                                <Setter TargetName="check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource GantryHoverBorderBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource GantryHoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#FF0A84FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#B3242426" SnapsToDevicePixels="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,20">
                <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Border x:Name="TypeSection" Background="#FF2C2C2E" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="BambuRadio" GroupName="Kind" IsChecked="True"/>
                        <RadioButton x:Name="ElegooRadio" GroupName="Kind"/>
                        <RadioButton x:Name="KlipperRadio" GroupName="Kind"/>
                        <RadioButton x:Name="PrusaRadio" GroupName="Kind"/>
                        <RadioButton x:Name="SnapmakerRadio" GroupName="Kind"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ElegooModelSection" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock x:Name="ElegooModelLabel" Margin="0,0,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                    <ComboBox x:Name="ElegooModelBox" SelectedIndex="0" Background="#FF2C2C2E" Foreground="#FFF5F5F7" Padding="8,5">
                        <ComboBoxItem Content="Centauri Carbon"/>
                        <ComboBoxItem Content="Centauri Carbon 2"/>
                    </ComboBox>
                </StackPanel>

                <Border x:Name="SnapmakerHintBox" Background="#332B79C2" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="SnapmakerHint" Foreground="#FFDCE6F2" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <StackPanel x:Name="DiscoverySection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="DetectedLabel" VerticalAlignment="Center" Foreground="#FF9A9A9E" FontSize="12"/>
                        <Button Grid.Column="1" x:Name="ScanButton" Content="⟳" Width="34" Height="28" Padding="0"/>
                    </Grid>
                    <Border Background="#FF2C2C2E" CornerRadius="8" Margin="0,6,0,6" Padding="3">
                        <ListBox x:Name="DetectedList" Height="110" Background="Transparent" Foreground="#FFF5F5F7" BorderThickness="0"/>
                    </Border>
                    <CheckBox x:Name="ImportConsent" Foreground="#FFF5F5F7" Margin="0,2,0,2"/>
                    <TextBlock x:Name="ImportHint" Foreground="#FF9A9A9E" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <Button x:Name="ImportButton" Height="30" Margin="0,0,0,8" IsEnabled="False"/>
                    <TextBlock x:Name="SubnetTargetsLabel" Foreground="#FF9A9A9E" FontSize="12"
                               TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBox x:Name="SubnetTargetsBox" FontSize="13" Padding="8,5"
                             Background="#FF2C2C2E" Foreground="#FFF5F5F7" CaretBrush="#FFF5F5F7"
                             BorderBrush="#33FFFFFF" BorderThickness="1"/>
                    <TextBlock x:Name="SubnetTargetsError" Foreground="#FFE0912B" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="SubnetTargetsHint" Foreground="#FF9A9A9E" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,8"/>
                    <Border Height="1" Background="#20FFFFFF" Margin="0,4,0,10"/>
                </StackPanel>

                <TextBlock x:Name="NameLabel" Margin="0,4,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                <TextBox x:Name="NameBox"/>

                <!-- Host takes the width; the short Port sits beside it instead of on its own row. -->
                <Grid Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock x:Name="HostLabel" Margin="0,0,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                        <TextBox x:Name="HostBox"/>
                    </StackPanel>
                    <StackPanel x:Name="PortColumn" Grid.Column="1">
                        <TextBlock x:Name="PortLabel" Margin="0,0,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                        <TextBox x:Name="PortBox" Width="96" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="SerialLabel" Margin="0,9,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                <TextBox x:Name="SerialBox"/>
                <TextBlock x:Name="CodeLabel" Margin="0,9,0,3" FontSize="12" Foreground="#FFC7C7CC"/>
                <TextBox x:Name="CodeBox"/>
                <TextBlock x:Name="ApiKeyLabel" Margin="0,9,0,3" FontSize="12" Foreground="#FFC7C7CC" Visibility="Collapsed"/>
                <TextBox x:Name="ApiKeyBox" Visibility="Collapsed"/>

                <CheckBox x:Name="ProgressCheck" Margin="0,14,0,0" Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText" Foreground="#FFFF453A" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="CancelButton" MinWidth="92" Height="32" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" MinWidth="110" Height="32"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
