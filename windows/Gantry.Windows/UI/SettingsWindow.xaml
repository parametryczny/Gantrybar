<Window x:Class="Gantry.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gantry" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="True"
        AllowsTransparency="False" Background="Transparent"
        Foreground="#FFF5F5F7" FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <!-- Soft, readable buttons instead of the classic WPF chrome. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rounded checkbox with an accent fill when checked; high contrast on the dark card. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF5F5F7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                    Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="check" Text="✓" FontSize="13" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#FF0A84FF"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#FF0A84FF"/>
                                <Setter TargetName="check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#99FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="#B3242426" SnapsToDevicePixels="True">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>

            <TextBlock x:Name="GeneralHeading" FontSize="12" FontWeight="SemiBold" Foreground="#FFAEAEB2" Margin="0,16,0,8"/>
            <Border Background="#D83A3A3C" CornerRadius="12" Padding="16,12" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" FontSize="13"/>
                        <Button Grid.Column="1" x:Name="LanguageButton" MinWidth="96"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TransparencyLabel" VerticalAlignment="Center" FontSize="13"/>
                        <Button Grid.Column="1" x:Name="TransparencyButton" MinWidth="96"/>
                    </Grid>
                    <CheckBox x:Name="StartupCheckBox" Margin="0,10,0,4"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="NotificationsHeading" FontSize="12" FontWeight="SemiBold" Foreground="#FFAEAEB2" Margin="0,18,0,8"/>
            <Border Background="#D83A3A3C" CornerRadius="12" Padding="16,10" BorderBrush="#20FFFFFF" BorderThickness="1">
                <StackPanel>
                    <CheckBox x:Name="PrintFinishedCheckBox" Margin="0,7"/>
                    <CheckBox x:Name="PrinterErrorCheckBox" Margin="0,7"/>
                    <CheckBox x:Name="PrintPausedCheckBox" Margin="0,7"/>
                    <CheckBox x:Name="LowFilamentCheckBox" Margin="0,7"/>
                    <CheckBox x:Name="HighHumidityCheckBox" Margin="0,7"/>
                    <Border Height="1" Background="#18FFFFFF" Margin="0,9"/>
                    <CheckBox x:Name="QuietHoursCheckBox" Margin="0,4"/>
                    <StackPanel x:Name="QuietTimesRow" Orientation="Horizontal" Margin="30,6,0,2">
                        <TextBlock x:Name="QuietFromLabel" VerticalAlignment="Center" FontSize="12" Foreground="#FFC7C7CC" Margin="0,0,6,0"/>
                        <TextBox x:Name="QuietStartBox" Width="58" FontSize="13" Padding="6,3" Background="#FF2C2C2E" Foreground="#FFF5F5F7" CaretBrush="#FFF5F5F7" BorderBrush="#33FFFFFF" BorderThickness="1" TextAlignment="Center"/>
                        <TextBlock x:Name="QuietToLabel" VerticalAlignment="Center" FontSize="12" Foreground="#FFC7C7CC" Margin="10,0,6,0"/>
                        <TextBox x:Name="QuietEndBox" Width="58" FontSize="13" Padding="6,3" Background="#FF2C2C2E" Foreground="#FFF5F5F7" CaretBrush="#FFF5F5F7" BorderBrush="#33FFFFFF" BorderThickness="1" TextAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="UpdatesHeading" FontSize="12" FontWeight="SemiBold" Foreground="#FFAEAEB2" Margin="0,18,0,8"/>
            <Border Background="#D83A3A3C" CornerRadius="12" Padding="16,12" BorderBrush="#20FFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" FontSize="12" Foreground="#FF9A9A9E" TextWrapping="Wrap"/>
                    <Button Grid.Column="1" x:Name="CheckUpdatesButton" MinWidth="120" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Button x:Name="CloseButton" MinWidth="104" HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True"/>
        </StackPanel>
    </Border>
</Window>
