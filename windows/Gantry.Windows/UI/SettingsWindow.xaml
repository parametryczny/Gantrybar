<Window x:Class="Gantry.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gantry" Width="640" Height="720" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        AllowsTransparency="False" Background="Transparent"
        Foreground="{DynamicResource SettingsTextBrush}" FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <!-- Values are replaced from GTheme whenever the user switches appearance. -->
        <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFF2F3F1"/>
        <SolidColorBrush x:Key="SettingsSecondaryBrush" Color="#FFA7AAA6"/>
        <SolidColorBrush x:Key="SettingsMutedBrush" Color="#FF6D716E"/>
        <SolidColorBrush x:Key="SettingsPanelBrush" Color="#E6151719"/>
        <SolidColorBrush x:Key="SettingsCardBrush" Color="#CC151719"/>
        <SolidColorBrush x:Key="SettingsLineBrush" Color="#17FFFFFF"/>
        <SolidColorBrush x:Key="SettingsFieldBrush" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="SettingsSoftBrush" Color="#1EFFFFFF"/>
        <SolidColorBrush x:Key="SettingsSoftHoverBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="SettingsSoftPressedBrush" Color="#4DFFFFFF"/>
        <SolidColorBrush x:Key="SettingsCheckIdleBrush" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="SettingsCheckBorderBrush" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="SettingsCheckHoverBrush" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="SettingsAccentBrush" Color="#FFD4D7D3"/>
        <SolidColorBrush x:Key="SettingsAccentInkBrush" Color="#FF151719"/>

        <!-- Soft, readable buttons instead of the classic WPF chrome. -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource SettingsSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SettingsSoftHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SettingsSoftPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every boolean setting is a full-width row: the label keeps the left column, the switch the
             right one, exactly like macOS. Because the label still travels as the CheckBox's Content,
             the existing code-behind assignments keep working untouched. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="rowbg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- String content becomes a TextBlock, so the wrap has to be set
                                     through a style: TextWrapping is not attachable to a presenter. -->
                                <ContentPresenter VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border x:Name="track" Grid.Column="1" Width="38" Height="22" CornerRadius="11"
                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource SettingsCheckIdleBrush}"
                                        BorderBrush="{DynamicResource SettingsCheckBorderBrush}" BorderThickness="1">
                                    <Ellipse x:Name="thumb" Width="16" Height="16" HorizontalAlignment="Left"
                                             Margin="2,0,0,0" Fill="{DynamicResource SettingsCheckHoverBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource SettingsAccentInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowbg" Property="Background" Value="{DynamicResource SettingsSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab pills. The selected one fills its cell so the corner radius reads as a pill, not a capsule. -->
        <Style x:Key="TabPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" CornerRadius="7" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource SettingsSoftHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SettingsMutedBrush}"/>
            <Setter Property="Margin" Value="2,18,0,7"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="RowSeparator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SettingsLineBrush}"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="14,10"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource SettingsPanelBrush}" SnapsToDevicePixels="True">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="22,20,22,0">
                <TextBlock x:Name="Heading" FontSize="19" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderSubtitle" FontSize="11" Foreground="{DynamicResource SettingsMutedBrush}" Margin="0,1,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="22,14,22,0" CornerRadius="9" Padding="3" Height="40"
                    Background="{DynamicResource SettingsSoftBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabGeneral" Style="{StaticResource TabPill}" GroupName="SettingsTabs" IsChecked="True"/>
                    <RadioButton x:Name="TabAppearance" Grid.Column="1" Style="{StaticResource TabPill}" GroupName="SettingsTabs" Margin="2,0"/>
                    <RadioButton x:Name="TabAdvanced" Grid.Column="2" Style="{StaticResource TabPill}" GroupName="SettingsTabs"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <!-- OGÓLNE -->
                <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                    <StackPanel>
                        <TextBlock x:Name="GeneralHeading" Style="{StaticResource GroupHeading}" Margin="2,0,0,7"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LanguageLabel" Style="{StaticResource RowLabel}"/>
                                    <Button Grid.Column="1" x:Name="LanguageButton" MinWidth="96"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="StartupCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="SpoolbaseCheckBox"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="NotificationsHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="PrintFinishedCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="FinishingSoonCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="PrinterErrorCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="PrintPausedCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="LowFilamentCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="HighHumidityCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="QuietHoursCheckBox"/>
                                <StackPanel x:Name="QuietTimesRow" Orientation="Horizontal" Margin="14,0,14,12">
                                    <TextBlock x:Name="QuietFromLabel" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBox x:Name="QuietStartBox" Width="58" FontSize="13" Padding="6,3" Background="{DynamicResource SettingsFieldBrush}" Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="{DynamicResource SettingsTextBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1" TextAlignment="Center"/>
                                    <TextBlock x:Name="QuietToLabel" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}" Margin="10,0,6,0"/>
                                    <TextBox x:Name="QuietEndBox" Width="58" FontSize="13" Padding="6,3" Background="{DynamicResource SettingsFieldBrush}" Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="{DynamicResource SettingsTextBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1" TextAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdatesHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap"/>
                                    <Button Grid.Column="1" x:Name="CheckUpdatesButton" MinWidth="120" Margin="10,0,0,0"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="AutoUpdateCheckBox"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="AboutHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Margin="14,12">
                                <TextBlock x:Name="AboutVersion" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AboutAuthor" FontSize="11" Foreground="{DynamicResource SettingsSecondaryBrush}" Margin="0,3,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="GitHubButton" Margin="0,0,8,0"/>
                                    <Button x:Name="XButton"/>
                                </StackPanel>
                                <Button x:Name="SupportButton" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="SupportSubtitle" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- WYGLĄD -->
                <ScrollViewer x:Name="PageAppearance" VerticalScrollBarVisibility="Auto" Padding="22,0,22,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="AppearanceHeading" Style="{StaticResource GroupHeading}" Margin="2,0,0,7"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource RowLabel}"/>
                                    <Button Grid.Column="1" x:Name="ThemeButton" MinWidth="96"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TransparencyLabel" Style="{StaticResource RowLabel}"/>
                                    <Button Grid.Column="1" x:Name="TransparencyButton" MinWidth="96"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="MonochromeCheckBox"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="CardsHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="CardFileNameCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="CardProgressCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="CardTempsCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="CardFilamentsCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="CardSpoolGramsCheckBox"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="DockHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="DockEnableCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DockEdgeLabel" Style="{StaticResource RowLabel}"/>
                                    <Button Grid.Column="1" x:Name="DockEdgeButton" MinWidth="96"/>
                                </Grid>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="DockOnlyPrintingCheckBox"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="DockPrintersCaption" Style="{StaticResource GroupHeading}" Margin="2,14,0,7"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="DockPrintersList"/>
                        </Border>
                        <TextBlock x:Name="DockHint" FontSize="11" Foreground="{DynamicResource SettingsMutedBrush}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ZAAWANSOWANE -->
                <ScrollViewer x:Name="PageAdvanced" VerticalScrollBarVisibility="Auto" Padding="22,0,22,20" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DeveloperHeading" Style="{StaticResource GroupHeading}" Margin="2,0,0,7"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="DeveloperCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <CheckBox x:Name="ScriptActionsCheckBox"/>
                                <TextBlock x:Name="ScriptActionsHint" FontSize="10.5" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap" Margin="14,0,14,11"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TelegramHeading" Style="{StaticResource GroupHeading}" Text="TELEGRAM"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TelegramEnableCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <Grid Style="{StaticResource RowGrid}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TelegramTokenLabel" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource SettingsSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="TelegramTokenBox" FontFamily="Consolas" FontSize="12" Padding="6,4" Background="{DynamicResource SettingsFieldBrush}" Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="{DynamicResource SettingsTextBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1"/>
                                </Grid>
                                <Grid Style="{StaticResource RowGrid}" Margin="14,0,14,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TelegramChatLabel" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource SettingsSecondaryBrush}"/>
                                    <TextBox Grid.Column="1" x:Name="TelegramChatBox" FontFamily="Consolas" FontSize="12" Padding="6,4" Background="{DynamicResource SettingsFieldBrush}" Foreground="{DynamicResource SettingsTextBrush}" CaretBrush="{DynamicResource SettingsTextBrush}" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="1"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="14,0,14,10">
                                    <Button x:Name="TelegramTestButton" MinWidth="120"/>
                                    <TextBlock x:Name="TelegramStatus" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="TelegramHint" FontSize="11" Margin="14,0,14,12" TextWrapping="Wrap" Foreground="{DynamicResource SettingsMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="WebHeading" Style="{StaticResource GroupHeading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="WebDashboardCheckBox"/>
                                <Border Style="{StaticResource RowSeparator}"/>
                                <TextBlock x:Name="WebAddressLabel" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}" TextWrapping="Wrap" Margin="14,11,14,12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource SettingsLineBrush}" BorderThickness="0,1,0,0" Padding="22,11">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FooterVersion" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SettingsMutedBrush}"/>
                    <Button Grid.Column="1" x:Name="CloseButton" MinWidth="104" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
