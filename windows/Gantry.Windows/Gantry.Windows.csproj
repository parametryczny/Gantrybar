<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.x TFM pulls in the WinRT projections needed for Action Center toast notifications
         (Microsoft.Toolkit.Uwp.Notifications). WPF + WinForms still work under this TFM. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Gantry</AssemblyName>
    <RootNamespace>Gantry</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.10.0</Version>
    <Product>Gantry</Product>
    <ApplicationIcon>gantry.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <!-- Native Windows toast notifications (Action Center). Auto-registers an AUMID + Start Menu
         shortcut for this unpackaged app on first Show(); see UI/WindowsToast.cs. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Camera frames are supplied by the Windows MediaCapture API; ZXing decodes the raw BGRA pixels. -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- Bambu chamber camera (rtsps/H.264) is decoded by a bundled ffmpeg.exe into an MJPEG pipe;
         see UI/DetailWindow.cs. ffmpeg.exe is fetched and placed next to the app by CI (windows.yml). -->
  </ItemGroup>

  <!-- Bundled Spoolbase filament catalog, copied next to the exe (Assets/). -->
  <ItemGroup>
    <Content Include="Assets\filament-catalog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Gantry wordmark logo (embedded resource, used in the dashboard header). -->
    <Resource Include="Assets\wordmark.png" />
    <!-- Translation catalog, shared verbatim with the macOS and Linux builds. -->
    <Content Include="..\..\i18n\*.json" Link="i18n\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- WPF + WinForms both add implicit global usings; drop the WinForms ones so WPF types
       (Application, Color, Button) are unambiguous. TrayIcon.cs imports them explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
