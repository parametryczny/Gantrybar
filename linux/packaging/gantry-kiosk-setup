#!/bin/sh
set -eu

AUTOSTART_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
AUTOSTART_FILE="$AUTOSTART_DIR/gantry-kiosk.desktop"
LOCALE_NAME="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"

case "$LOCALE_NAME" in
  de*)
    DISABLED="Gantry Werkstatt: Autostart deaktiviert."
    ENABLED="Gantry Werkstatt: Autostart aktiviert."
    TEMPLATE="CSV-Vorlage"
    RUN_NOW="Jetzt starten mit"
    DISABLE="Autostart deaktivieren"
    ;;
  pl*)
    DISABLED="Gantry Workshop: autostart wyłączony."
    ENABLED="Gantry Workshop: autostart włączony."
    TEMPLATE="Szablon CSV"
    RUN_NOW="Uruchom teraz poleceniem"
    DISABLE="Wyłącz autostart"
    ;;
  *)
    DISABLED="Gantry Workshop: autostart disabled."
    ENABLED="Gantry Workshop: autostart enabled."
    TEMPLATE="CSV template"
    RUN_NOW="Start now with"
    DISABLE="Disable autostart"
    ;;
esac

if [ "${1:-}" = "--disable" ]; then
  rm -f "$AUTOSTART_FILE"
  printf '%s\n' "$DISABLED"
  exit 0
fi

mkdir -p "$AUTOSTART_DIR"
rm -f "$AUTOSTART_DIR/gantry.desktop"
install -m 0644 /usr/share/applications/gantry-kiosk.desktop "$AUTOSTART_FILE"

if command -v xdg-user-dir >/dev/null 2>&1; then
  DOCUMENTS_DIR=$(xdg-user-dir DOCUMENTS)
else
  DOCUMENTS_DIR="${XDG_DOCUMENTS_DIR:-$HOME/Documents}"
fi
mkdir -p "$DOCUMENTS_DIR"
if [ ! -e "$DOCUMENTS_DIR/Gantry-printers-template.csv" ]; then
  install -m 0600 /usr/share/doc/gantry/Gantry-printers-template.csv "$DOCUMENTS_DIR/Gantry-printers-template.csv"
fi

printf '%s\n' \
  "$ENABLED" \
  "$TEMPLATE: $DOCUMENTS_DIR/Gantry-printers-template.csv" \
  "$RUN_NOW: gantry-kiosk" \
  "$DISABLE: gantry-kiosk-setup --disable"
